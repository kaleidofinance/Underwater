# ─── Ink network endpoints ────────────────────────────────────────────────
# Verified live on 2026-08-23. Defaults are already in foundry.toml; set these
# only to override with a private//paid RPC.
#   Ink mainnet     chainId 57073   explorer https://explorer.inkonchain.com
#   Ink Sepolia     chainId 763373  explorer https://explorer-sepolia.inkonchain.com
# Native gas token is ETH on both.
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_SEPOLIA_RPC_URL=https://rpc-gel-sepolia.inkonchain.com

# ─── Deployer ─────────────────────────────────────────────────────────────
# Burner key for testnet only. For mainnet prefer --ledger / --trezor and
# leave this blank.
PRIVATE_KEY=

# ─── DEX deployment (script/DeployDex.s.sol) ──────────────────────────────
# Run this BEFORE Deploy.s.sol: it prints the router address to paste into
# DEX_ROUTER below. Skip it only if you're using a third-party V2 router.

# Owner of UnderwaterFactory. Its only power is setFeeTo - no pause, no
# blocklist, no upgrade. Defaults to the deployer if unset; prefer a multisig.
OWNER=

# WETH address the router wraps ETH through. Defaults to the OP Stack predeploy
# 0x4200000000000000000000000000000000000006, which is live with identical
# bytecode on both Ink networks. Only set this for a non-OP-Stack chain or a
# local run against a freshly deployed WETH9.
WETH=

# ─── Launchpad configuration ──────────────────────────────────────────────
# Receives trade fees, creation fees and the graduation cut.
# Defaults to the deployer if unset.
FEE_RECIPIENT=

# Uniswap-V2-compatible router used to seed liquidity at graduation. Either our
# own UnderwaterRouter (from DeployDex.s.sol) or a third-party one.
#
# Ink Sepolia: no third-party V2 router exists. Deploy our own DEX first and
#   paste its router address here.
#
# Ink mainnet, third-party option: 0xA8C1C38FF57428e5C3a34E0899Be5Cb385476507
#   Identified on-chain, not from docs: 1,218,299 transactions, factory
#   0x458C5d5B75ccBA22651D2C5b61cB1EA1e0b0f95D with ~350 pairs (the largest
#   V2 deployment on Ink), WETH 0x4200000000000000000000000000000000000006.
#   A sibling router 0x5D0cAfB2Bc6CAbD100472C8d72D8185a8EBe1889 shares the
#   same factory but has zero transactions - do not use it. Which DEX brand it
#   belongs to is unidentified; it is confirmed canonical only by behaviour.
#   Exercised end-to-end by test/fork/InkGraduation.t.sol.
#
# Either way the deploy script refuses an address that doesn't answer
# factory() and WETH(), so a wrong value fails at deploy time rather than
# parking every graduation.
DEX_ROUTER=

# Trade fee in bps (100 = 1%). Contract hard cap: 200.
TRADE_FEE_BPS=100

# Flat creation fee in wei. 0 disables. Contract hard cap: 0.01 ether.
CREATION_FEE=0

# Protocol cut of the graduation raise in bps (500 = 5%). Hard cap: 1000.
GRADUATION_FEE_BPS=500

# ─── Underwater plates NFT (script/DeployPlates.s.sol) ────────────────────
# The 2222-plate collection. Independent of the launchpad above; nothing here
# is needed to deploy or run the token launchpad.

# Aave V3 Pool the art reads health factors from. Immutable once deployed: a
# settable risk source would be a lever over everybody's art. The deploy script
# refuses an address that does not report type(uint256).max for a fresh account,
# so a wrong value fails at deploy time instead of after the mint.
AAVE_POOL=

# keccak256(abi.encode(uint256[371] packedTraitTable)), produced by the trait
# generator and published BEFORE minting opens. Immutable, has no default, and
# a collection deployed with the wrong value can never be sealed. Print it with
# the generator, and keep the table file that produced it.
PLATES_PROVENANCE=

# Receives mint proceeds, the reserve plates and ERC2981 royalties. `withdraw`
# is hardcoded to this address and callable by anyone, so it cannot be
# redirected later. Defaults to the deployer if unset; prefer a multisig.
PLATES_TREASURY=

# Public mint price in wei. Settable after deploy with `setPrice`, bounded by
# PRICE_CEILING (1 ether) in the constructor and in the setter. Default
# 0.0222 ether.
PLATES_PRICE=

# Allowlist mint price in wei, charged by `mintWhitelist`. This one targets a
# dollar figure - $10 - which no fixed ETH amount holds, so it is settable with
# `setWhitelistPrice` and re-pegged as ETH moves. The default 0.00333 ether
# assumes $3,000/ETH; CHECK THE RATE before a real deploy rather than trusting
# it. Payment must be exact, so a re-peg under a pending mint makes that mint
# revert rather than overcharging the buyer.
PLATES_WL_PRICE=

# Plates minted to the treasury at seal, before either mint phase opens.
# Contract hard cap: 222 (10% of supply). Default 222.
PLATES_RESERVE=

# Seconds the mint stays open, from deploy. After it closes, `reveal` becomes
# callable by anyone even if the collection has not sold out, so a slow mint
# cannot strand the art unrevealed. Default 14 days (1209600).
PLATES_MINT_WINDOW=

# ─── Sealing the table (script/SealPlates.s.sol) ──────────────────────────
# Deployed collection address, printed by DeployPlates.s.sol.
PLATES=

# The packed trait table: exactly 371 comma-separated uint256 words, in slot
# order. The script hashes them locally and refuses to send anything unless the
# hash equals the on-chain provenance.
PLATES_TABLE=

# ─── Opening the allowlist (script/SetWhitelist.s.sol) ────────────────────
# All three come from `python script/whitelist.py`, which reads
# script/whitelist.txt and writes web/whitelist.json.

# Root of the allowlist tree. 1000 plates (WL_ALLOCATION) are reserved for the
# phase it opens; whatever it does not use rolls into the public mint. A wrong
# root fails silently - the transaction succeeds and then nobody on the list can
# mint - which is why the two below exist.
WL_ROOT=

# One address from the list, and its proof, so the script can verify the root
# before broadcasting it. Optional, but skipping them means broadcasting a root
# nothing has checked. WL_PROOF is comma-separated bytes32 words.
WL_MEMBER=
WL_PROOF=
