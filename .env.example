# ─── Network endpoints ────────────────────────────────────────────────────
# Verified live on 2026-08-23 (Ink) and 2026-08-30 (Robinhood). Defaults are
# already in foundry.toml; set these only to override with a private/paid RPC.
#   Ink mainnet       chainId 57073   explorer https://explorer.inkonchain.com
#   Ink Sepolia       chainId 763373  explorer https://explorer-sepolia.inkonchain.com
#   Robinhood         chainId 4663    explorer https://robinhoodchain.blockscout.com
#   Robinhood testnet chainId 46630   explorer https://explorer.testnet.chain.robinhood.com
# Native gas token is ETH on all four. Ink is OP Stack and ~1s per block;
# Robinhood is Arbitrum Nitro and ~0.1s, which is why the two have different
# log-scan windows in web/lib/chains.ts.
#
# Note the Robinhood hosts: the one chainlist carries, rpc.chain.robinhood.com,
# does not resolve. These do, and each network has exactly one known public
# endpoint - a real weakness, not an omission.
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_SEPOLIA_RPC_URL=https://rpc-gel-sepolia.inkonchain.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# ─── Deployer ─────────────────────────────────────────────────────────────
# Burner key for testnet only. For mainnet prefer --ledger / --trezor and
# leave this blank.
PRIVATE_KEY=

# ─── DEX deployment (script/DeployDex.s.sol) ──────────────────────────────
# Run this BEFORE Deploy.s.sol: it prints the router address to paste into
# DEX_ROUTER below. Skip it only if you're using a third-party V2 router.

# Owner of UnderwaterFactory. Its only power is setFeeTo - no pause, no
# blocklist, no upgrade. Defaults to the deployer if unset; prefer a multisig.
OWNER=

# WETH address the router wraps ETH through. Resolved from the chain id by
# script/Weth.sol, so it does not need setting on a chain that table knows:
# both Ink networks use the OP Stack predeploy 0x4200...0006, and both Robinhood
# networks have their own deployment (Nitro has no predeploys). Set this only for
# a chain that is not in the table, or a local run against a fresh WETH9.
# test/fork/Weth.t.sol re-checks every entry against the live chains.
WETH=

# ─── Launchpad configuration ──────────────────────────────────────────────
# Receives trade fees, creation fees and the graduation cut.
# Defaults to the deployer if unset.
FEE_RECIPIENT=

# Uniswap-V2-compatible router used to seed liquidity at graduation. Either our
# own UnderwaterRouter (from DeployDex.s.sol) or a third-party one.
#
# Ink Sepolia: no third-party V2 router exists. Deploy our own DEX first and
#   paste its router address here.
#
# Ink mainnet, third-party option: 0xA8C1C38FF57428e5C3a34E0899Be5Cb385476507
#   Identified on-chain, not from docs: 1,218,299 transactions, factory
#   0x458C5d5B75ccBA22651D2C5b61cB1EA1e0b0f95D with ~350 pairs (the largest
#   V2 deployment on Ink), WETH 0x4200000000000000000000000000000000000006.
#   A sibling router 0x5D0cAfB2Bc6CAbD100472C8d72D8185a8EBe1889 shares the
#   same factory but has zero transactions - do not use it. Which DEX brand it
#   belongs to is unidentified; it is confirmed canonical only by behaviour.
#   Exercised end-to-end by test/fork/InkGraduation.t.sol.
#
# Either way the deploy script refuses an address that doesn't answer
# factory() and WETH(), so a wrong value fails at deploy time rather than
# parking every graduation.
DEX_ROUTER=

# Trade fee in bps (100 = 1%). Contract hard cap: 200.
TRADE_FEE_BPS=100

# Flat creation fee in wei. 0 disables. Contract hard cap: 0.01 ether.
CREATION_FEE=0

# Protocol cut of the graduation raise in bps (500 = 5%). Hard cap: 1000.
GRADUATION_FEE_BPS=500

# ─── Underwater plates NFT (script/DeployPlates.s.sol) ────────────────────
# The 2222-plate collection. Independent of the launchpad above; nothing here
# is needed to deploy or run the token launchpad.

# Aave V3 Pool the art reads health factors from. Immutable once deployed: a
# settable risk source would be a lever over everybody's art.
#
# LEAVE THIS BLANK for either Ink network. Because it can never be corrected, the
# address is a constant in script/InkAave.sol resolved from the chain id, not a
# value you have to get right by hand on the one deploy that cannot be undone:
#   Ink mainnet  57073   0x2816cf15F6d2A220E789aA011D5EE4eB6c47FEbA
#   Ink Sepolia  763373  0x6807dc923806fE8Fd134338EABCA509979a7e0cB
# Verified 2026-08-25 by calling both chains: each reports type(uint256).max for
# an address with no debt, a non-zero POOL_REVISION, and a non-empty reserves
# list (13 assets on mainnet, 3 on Sepolia). test/fork/InkAavePool.t.sol re-checks
# all of it against the live markets, so a stale constant is a test failure.
#
# Ink mainnet's is an Aave WHITELABEL instance - the Aave V3 codebase operated
# under licence by a third party, not the canonical Aave DAO market, because
# there is no canonical Aave V3 deployment on Ink. See the README trust model.
#
# Set this only to override: a local run against MockAavePool, or a fork. The
# deploy script rejects an address that does not answer like a V3 pool and has at
# least one reserve listed, so a wrong value fails at deploy time.
AAVE_POOL=

# keccak256(abi.encode(uint256[371] packedTraitTable)), produced by the trait
# generator and published BEFORE minting opens. Immutable, has no default, and
# a collection deployed with the wrong value can never be sealed. Print it with
# the generator, and keep the table file that produced it.
PLATES_PROVENANCE=

# Receives mint proceeds, the reserve plates and ERC2981 royalties. `withdraw`
# is hardcoded to this address and callable by anyone, so it cannot be
# redirected later. Defaults to the deployer if unset; prefer a multisig.
PLATES_TREASURY=

# Public mint price in wei. Settable after deploy with `setPrice`, bounded by
# PRICE_CEILING (1 ether) in the constructor and in the setter. Default
# 0.0222 ether.
PLATES_PRICE=

# Allowlist mint price in wei, charged by `mintWhitelist`. This one targets a
# dollar figure - $10 - which no fixed ETH amount holds, so it is settable with
# `setWhitelistPrice` and re-pegged as ETH moves. The default 0.00333 ether
# assumes $3,000/ETH; CHECK THE RATE before a real deploy rather than trusting
# it. Payment must be exact, so a re-peg under a pending mint makes that mint
# revert rather than overcharging the buyer.
PLATES_WL_PRICE=

# Plates minted to the treasury at seal, before either mint phase opens.
# Contract hard cap: 222 (10% of supply). Default 222, but set this to 0 for a
# real deploy: 2000 allowlist plates plus a 222 reserve is the whole 2222 supply,
# leaving nothing for the public phase. ALLOWLIST.md commits to a zero reserve.
PLATES_RESERVE=

# Seconds the mint stays open, from deploy. After it closes, `reveal` becomes
# callable by anyone even if the collection has not sold out, so a slow mint
# cannot strand the art unrevealed. Default 14 days (1209600).
PLATES_MINT_WINDOW=

# Allowlist plates one address may mint, applied right after the deploy. The
# constructor sets 22, which fits the whole 2000-plate allocation inside 91
# addresses; 1 spreads it over 2000 people, one plate each. Blank leaves the
# constructor's value.
#
# Worth setting here even though SetWhitelist.s.sol sets it authoritatively later:
# /mint shows this number to everybody registering for the allowlist, so a
# collection left at 22 for the whole registration window advertises a list that
# reaches 90 people. Only applied when the deployer is also OWNER; otherwise the
# script prints the call for the owner to make.
PLATES_MAX_PER_WALLET=1

# ─── Waitlist (script/DeployWaitlist.s.sol) ───────────────────────────────
# Allowlist intake: a separate, ownerless contract that records who asked for a
# spot. It holds no addresses at deploy and knows nothing about the collection.
#
# The window is fixed in the constructor and there is NO SETTER - it cannot be
# extended, cut short or reopened. The dry run prints both timestamps and the
# number of hours between them, which is the only chance to check them.

# Unix timestamp registration opens. Blank means the deploy block's timestamp,
# i.e. immediately.
WAITLIST_OPENS=

# Seconds the window stays open, from WAITLIST_OPENS. Default 7 days (604800).
WAITLIST_WINDOW=

# Unix timestamp registration closes. Overrides WAITLIST_WINDOW when set. Must be
# after both WAITLIST_OPENS and the current block, or the deploy is refused - a
# window that can never accept anybody is not worth the gas.
WAITLIST_CLOSES=

# ─── Sealing the table (script/SealPlates.s.sol) ──────────────────────────
# Deployed collection address, printed by DeployPlates.s.sol.
PLATES=

# The packed trait table: exactly 371 comma-separated uint256 words, in slot
# order. The script hashes them locally and refuses to send anything unless the
# hash equals the on-chain provenance.
PLATES_TABLE=

# ─── Opening the allowlist (script/SetWhitelist.s.sol) ────────────────────
# All three come from `python script/whitelist.py`, which reads
# script/whitelist.txt and writes web/whitelist.json.

# Root of the allowlist tree. 2000 plates (WL_ALLOCATION) are reserved for the
# phase it opens; whatever it does not use rolls into the public mint. A wrong
# root fails silently - the transaction succeeds and then nobody on the list can
# mint - which is why the two below exist.
WL_ROOT=

# One address from the list, and its proof, so the script can verify the root
# before broadcasting it. Optional, but skipping them means broadcasting a root
# nothing has checked. WL_PROOF is comma-separated bytes32 words.
WL_MEMBER=
WL_PROOF=

# Allowlist plates one address may mint. Sent in the SAME broadcast as the root
# and deliberately in the transaction BEFORE it: for the few seconds between the
# two the allowlist is live, and the tighter limit being briefly in force is
# harmless where the looser one is not. Blank leaves the current value alone,
# which is what a second wave that only replaces the root wants.
#
# This limit binds mintWhitelist only - the public mint is bounded by maxPerTx -
# so it never needs raising when openPublicMint runs.
WL_MAX_PER_WALLET=1
