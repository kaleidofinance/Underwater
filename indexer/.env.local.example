# Copy to indexer/.env.local.
#
# Every name here is one the rest of the repo already uses, so the shortest way to
# configure this is to copy web/.env.local over the top of it — the launchpad
# addresses and the RPC URLs are the same variables. Nothing in this file is
# NEXT_PUBLIC_: an indexer has no browser bundle, so every value stays server-side.

# ── Which chains to index ─────────────────────────────────────────────────────
# A chain with no launchpad address is skipped entirely rather than started empty.
# The NEXT_PUBLIC_-prefixed names the frontend uses are accepted as a fallback, so
# a copied web/.env.local works as-is; set these to point the indexer somewhere
# the app is not.
LAUNCHPAD_INK=
LAUNCHPAD_INK_SEPOLIA=
LAUNCHPAD_ROBINHOOD=
LAUNCHPAD_ROBINHOOD_TESTNET=
LAUNCHPAD_ANVIL=

# ── uwPoints, optional per chain ──────────────────────────────────────────────
# The two other contracts a point balance is made of. Both are optional and each
# is independent: a chain with a launchpad and no waitlist indexes trades and
# launches and simply has no registrations, and the /points routes still answer.
#
# Leave them unset and the app falls back to its own eth_getLogs scan for points
# — the market and volume routes are unaffected either way. The mismatch that is
# worth avoiding is the other direction: an address here that is NOT the one the
# app has under NEXT_PUBLIC_WAITLIST_<KEY> / NEXT_PUBLIC_POINTS_<KEY>. The app
# checks for exactly that on /chains and refuses the indexed path rather than
# serving somebody else's history.
WAITLIST_INK=
WAITLIST_INK_SEPOLIA=
WAITLIST_ROBINHOOD=
WAITLIST_ROBINHOOD_TESTNET=
WAITLIST_ANVIL=

POINTS_INK=
POINTS_INK_SEPOLIA=
POINTS_ROBINHOOD=
POINTS_ROBINHOOD_TESTNET=
POINTS_ANVIL=

# The deploy block, so a backfill starts where the history does instead of at
# genesis. Zero works and is slow — on Robinhood's 0.1s blocks it is millions of
# empty blocks. POINTS_FROM_BLOCK_<KEY> is accepted as a fallback since it is the
# same number whenever the two contracts were deployed together.
#
# When both are set the points streams start at the LOWER of the two, never at
# START_BLOCK. A launchpad redeployed later has a higher START_BLOCK than the
# waitlist it inherited, and a registration below that floor would be dropped —
# leaving a balance short by one `register` rate, which looks exactly like a
# wallet that never registered. Costing a few extra empty blocks is the cheaper
# mistake.
START_BLOCK_INK=
START_BLOCK_INK_SEPOLIA=
START_BLOCK_ROBINHOOD=
START_BLOCK_ROBINHOOD_TESTNET=
START_BLOCK_ANVIL=

# Where the app floors its own points scan. Read here as the fallback for
# START_BLOCK_<KEY> above, and as the other half of the minimum when both exist.
POINTS_FROM_BLOCK_INK=
POINTS_FROM_BLOCK_INK_SEPOLIA=
POINTS_FROM_BLOCK_ROBINHOOD=
POINTS_FROM_BLOCK_ROBINHOOD_TESTNET=
POINTS_FROM_BLOCK_ANVIL=

# ── RPC, required per configured chain ────────────────────────────────────────
# Same variables the web app's server reads (see web/.env.local.example), comma
# separated for a primary and a spare. Required rather than optional, and the config
# refuses to start without one — not because a public endpoint cannot cope (Ink
# Sepolia's whole history backfilled in 2m 45s on the public gel endpoint) but
# because which endpoint a backfill hammers should be somebody's decision. There is
# no throttle to fall back on either way: `maxRequestsPerSecond` is deprecated in
# Ponder 0.17 and read nowhere, so its retry backoff is the entire rate strategy.
#
# It has to be an ARCHIVE endpoint: TokenCreated is handled with eth_calls at the
# event's block. Robinhood Testnet's public RPC keeps about 11,166 blocks — some 28
# minutes at 0.15s blocks — so it cannot serve a backfill from the deploy block and
# the chain stalls at 0.0% retrying `metadata is not found`. See README.md,
# "Chains that need an archive RPC".
INK_RPC_URL=
INK_SEPOLIA_RPC_URL=
ROBINHOOD_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
ANVIL_RPC_URL=http://127.0.0.1:8545

# ── Storage ───────────────────────────────────────────────────────────────────
# Unset means PGlite in .ponder/pglite, which is what makes the anvil loop work
# with nothing installed. Set it to a Postgres connection string for anything
# that has to survive a restart.
DATABASE_URL=

# Which Postgres schema to write into. `ponder dev` defaults to "public"; `ponder
# start` refuses to guess and fails without this, deliberately — the schema is the
# deploy slot. Give each release its own name and the old one keeps serving until
# the new one has finished its backfill, which is how a redeploy avoids a window
# where the API is live and the tables are half-full.
#
# It is not optional in a second sense: pointing new code at a schema an older
# build wrote is a hard error, not a migration ("Schema X was previously used by a
# different Ponder app"). On Railway, `uw_${{RAILWAY_GIT_COMMIT_SHA}}` satisfies
# both halves — it rotates when the code does, and a restart of the same commit
# reuses the schema and resumes instead of backfilling again.
DATABASE_SCHEMA=public
