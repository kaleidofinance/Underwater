{
  "name": "underwater-indexer",
  "private": true,
  "type": "module",
  "scripts": {
    "abis": "node scripts/abis.mjs",
    "vendor": "node scripts/abis.mjs && node scripts/curve.mjs",
    "codegen": "npm run vendor && ponder codegen",
    "dev": "npm run vendor && ponder dev",
