    "typecheck": "npm run codegen && tsc --noEmit",
    "db": "ponder db"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "ponder": "^0.17.8",
    "viem": "^2.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "railway": "^3.11.0",
    "typescript": "^5.6.0"
  }
}
