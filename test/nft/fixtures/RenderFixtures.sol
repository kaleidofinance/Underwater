    function verbatim() internal pure returns (Verbatim[] memory f) {
        f = new Verbatim[](2);
        // sealed, plate 6
        f[0] = Verbatim(
            "sealed",
            6,
            0x32023d244,
            1450000000000000000,
            3,
            false,
            "data:application/json;base64,"
        );
        // drowned, plate 6
        f[1] = Verbatim(
            "drowned",
            6,
            0x32023d244,
            1000000000000000000,
            3,
            true,
            "data:application/json;base64,"
        );
