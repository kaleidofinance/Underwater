# Copy to web/.env.local and fill in whatever you have deployed.
#
# Nothing is deployed to a real Ink network yet, so leave the first two blank
# until you run script/DeployDex.s.sol and script/Deploy.s.sol. The app reads
# these per chain and shows an honest "not deployed here" state when the one for
# the connected chain is missing, rather than calling into the zero address.
#
# These are NEXT_PUBLIC_, so they are inlined into the browser bundle at build
# time: they must be public addresses only, never a key, and the dev server has
# to be restarted after a change.

# Ink mainnet — chain 57073
NEXT_PUBLIC_LAUNCHPAD_INK=

# Ink Sepolia — chain 763373
NEXT_PUBLIC_LAUNCHPAD_INK_SEPOLIA=

# Robinhood Chain — chain 4663 — and its testnet, chain 46630. A second home for
# the launchpad rather than a move: the app switches between all of these, and a
# chain left blank here shows "not deployed" on its switcher row instead of
# disappearing from it.
NEXT_PUBLIC_LAUNCHPAD_ROBINHOOD=
NEXT_PUBLIC_LAUNCHPAD_ROBINHOOD_TESTNET=

# Local anvil — chain 31337. `npm run localchain` writes this line for you.
NEXT_PUBLIC_LAUNCHPAD_ANVIL=

# The plates collection, per chain. A separate deploy from the launchpad — a
# chain can have one and not the other, and /mint says so rather than calling
# into nothing. `npm run localchain` writes the anvil line, along with
# web/public/whitelist.json for the addresses it puts on the allowlist.
NEXT_PUBLIC_PLATES_INK=
NEXT_PUBLIC_PLATES_INK_SEPOLIA=
NEXT_PUBLIC_PLATES_ROBINHOOD=
NEXT_PUBLIC_PLATES_ROBINHOOD_TESTNET=
NEXT_PUBLIC_PLATES_ANVIL=

# The allowlist waitlist, per chain. A third independent deploy, and the only one
# with a life of its own: it opens and closes before the collection has a root,
# and once the tree is published it can be left blank again — /mint shows the
# registration panel only while the collection has nothing to sell. `npm run
# localchain` writes the anvil line and registers a few of its accounts.
NEXT_PUBLIC_WAITLIST_INK=
NEXT_PUBLIC_WAITLIST_INK_SEPOLIA=
NEXT_PUBLIC_WAITLIST_ROBINHOOD=
NEXT_PUBLIC_WAITLIST_ROBINHOOD_TESTNET=
NEXT_PUBLIC_WAITLIST_ANVIL=

# The points contract, per chain. Independent of all three above: a chain can have
# the launchpad and no points contract, which is the state it is in before this is
# deployed to it — the pages then show the counts against the indicative rate card
# in lib/points.ts rather than a total.
NEXT_PUBLIC_POINTS_INK=
NEXT_PUBLIC_POINTS_INK_SEPOLIA=
NEXT_PUBLIC_POINTS_ROBINHOOD=
NEXT_PUBLIC_POINTS_ROBINHOOD_TESTNET=
NEXT_PUBLIC_POINTS_ANVIL=

# Where each chain's points scan starts. NOT NEXT_PUBLIC — read server-side by
# app/api/points. Points are all-time, so the scan has to reach the first of our
# deploys; unset means genesis, which is correct and merely slow.
#
# Slow is worth measuring on the Robinhood pair before deploying points there.
# Their blocks come roughly ten times faster than Ink's, so genesis on Robinhood
# mainnet is already past fifty million blocks — set these two rather than leaving
# a balance to walk that. Too early is safe; too late silently drops history.
POINTS_FROM_BLOCK_INK=
POINTS_FROM_BLOCK_INK_SEPOLIA=
POINTS_FROM_BLOCK_ROBINHOOD=
POINTS_FROM_BLOCK_ROBINHOOD_TESTNET=

# WalletConnect, from a free project at cloud.reown.com. This is a public
# identifier, not a secret — it is meant to ship in the bundle.
#
# It is what lets someone connect from a phone by scanning a code. Left blank,
# the WalletConnect row simply does not appear in the connect dialog; the browser
# wallet and Coinbase Wallet need no configuration and are always there.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Server-side secret — NOT NEXT_PUBLIC, never shipped to the browser ────────
# Pinata API key for pinning /create token uploads to IPFS. Read only by
# app/api/upload/route.ts (server side). Sign up at https://app.pinata.cloud,
# create an API key, and paste its JWT here. Left blank, the launch form's
# uploads return a clean "not configured" error and no token gets an image.
PINATA_JWT=
