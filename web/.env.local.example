# Copy to .env.local for local development.

# The Underwater ZEC API (zec/server). Locally that's the sim server:
#   node zec/server/main.ts --sim
# Deployed previews and production point at the Railway API.
NEXT_PUBLIC_ZEC_API=http://localhost:8811

# 1 only against the sim server: shows the test-ZEC faucet on the Account page.
NEXT_PUBLIC_ZEC_SIM=1

# "mainnet" only for the mainnet build; anything else shows the TESTNET badge.
NEXT_PUBLIC_ZEC_NETWORK=testnet
