# What NOT to upload to Vercel on `vercel deploy`.
#
# When this file exists, the Vercel CLI uses it as the authoritative ignore
# list (it does not also apply .gitignore), so secrets MUST be listed here, or
# a normally-gitignored .env.local would be uploaded into the deployment source.

# Secrets — never upload
.env
.env.*

# Dependencies & build output — regenerated on Vercel
node_modules
.next
.vercel

# Local-only tooling, caches, scratch
.shots
tsconfig.tsbuildinfo
*.log
.tmp-*
